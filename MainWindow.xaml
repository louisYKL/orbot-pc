<Window x:Class="OrbotPc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbot PC" Icon="orbot-logo.png" Height="820" Width="1280" MinHeight="700" MinWidth="1040"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource PrimaryBrush}"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#18212A" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="NavSurface" Property="Background" Value="#1B2A2B" />
                                <Setter TargetName="NavSurface" Property="BorderBrush" Value="#29423C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0E141A" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24,18,18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="7,0,0,34">
                        <Image Source="orbot-logo.png" Width="36" Height="36" Stretch="Uniform" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Orbot PC" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Windows · 0.3.1" Foreground="{StaticResource SecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="NETWORK" Foreground="#667482" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,8" />
                    <Button x:Name="NavOverview" Style="{StaticResource NavButton}" Tag="Selected" Click="Nav_Click" CommandParameter="Overview">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◉" Foreground="{StaticResource AccentBrush}" Width="28" FontSize="17"/><TextBlock Text="连接概览" /></StackPanel>
                    </Button>
                    <Button x:Name="NavBridges" Style="{StaticResource NavButton}" Click="Nav_Click" CommandParameter="Bridges">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Foreground="{StaticResource SecondaryBrush}" Width="28" FontSize="19"/><TextBlock Text="桥接与网络" /></StackPanel>
                    </Button>
                    <Button x:Name="NavServices" Style="{StaticResource NavButton}" Click="Nav_Click" CommandParameter="Services">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◇" Foreground="{StaticResource SecondaryBrush}" Width="28" FontSize="18"/><TextBlock Text="洋葱服务" /></StackPanel>
                    </Button>
                    <Button x:Name="NavClientAuth" Style="{StaticResource NavButton}" Click="Nav_Click" CommandParameter="ClientAuth">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌑" Foreground="{StaticResource SecondaryBrush}" Width="28" FontSize="18"/><TextBlock Text="洋葱客户端授权" /></StackPanel>
                    </Button>
                    <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Click="Nav_Click" CommandParameter="Logs">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="≡" Foreground="{StaticResource SecondaryBrush}" Width="28" FontSize="18"/><TextBlock Text="运行日志" /></StackPanel>
                    </Button>
                    <TextBlock Text="PREFERENCES" Foreground="#667482" FontSize="10" FontWeight="SemiBold" Margin="12,28,0,8" />
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="Nav_Click" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Foreground="{StaticResource SecondaryBrush}" Width="28" FontSize="16"/><TextBlock Text="设置" /></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="7,0,7,0">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,15" />
                    <TextBlock Text="LOCAL PROXY" Foreground="#667482" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="SidebarProxyState" Text="已停止" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,6,0,2" />
                    <TextBlock Text="仅本机回环接口可访问" Foreground="#71808D" FontSize="10" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="42,28,42,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="连接概览" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="通过 Tor 建立加密连接，并将应用流量导入本机代理。" Foreground="{StaticResource SecondaryBrush}" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#707E89" Margin="0,0,8,0" />
                    <TextBlock x:Name="HeaderStatus" Text="未连接" Foreground="{StaticResource SecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="28" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="4,2,22,2">
                                    <TextBlock Text="PRIVATE ROUTING" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="ConnectionHeadline" Text="你的连接由你掌控" FontSize="24" FontWeight="SemiBold" Margin="0,11,0,0" />
                                    <TextBlock x:Name="ConnectionDetail" Text="启动 Tor 后，可通过本机 SOCKS5 或 HTTP 代理连接。" Foreground="{StaticResource SecondaryBrush}" FontSize="13" TextWrapping="Wrap" MaxWidth="440" Margin="0,8,0,20" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ConnectButton" Content="连接 Tor" Background="{StaticResource AccentBrush}" Foreground="#0B1713" BorderBrush="{StaticResource AccentBrush}" FontWeight="SemiBold" Padding="23,12" Click="Connect_Click" />
                                        <Button x:Name="NewIdentityButton" Content="新身份" Margin="10,0,0,0" IsEnabled="False" Click="NewIdentity_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Column="1" Height="218" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="205" Height="205" Stroke="#203A34" StrokeThickness="1" />
                                    <Ellipse Width="164" Height="164" Stroke="#25463C" StrokeThickness="1" />
                                    <Ellipse Width="124" Height="124" Stroke="#376A57" StrokeThickness="1" />
                                    <Ellipse Width="82" Height="82" Fill="#163026" Stroke="{StaticResource AccentDeepBrush}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="CorePulse" Width="34" Height="34" Fill="{StaticResource AccentBrush}" Opacity="0.88">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale" CenterX="17" CenterY="17" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="OrbitDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0">
                                        <Ellipse.RenderTransform><RotateTransform x:Name="OrbitRotation" CenterX="0" CenterY="103" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1">
                                        <TextBlock x:Name="BootstrapText" Text="Tor 已就绪" Foreground="{StaticResource SecondaryBrush}" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="SOCKS5" Foreground="{StaticResource SecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SocksEndpoint" Text="127.0.0.1:9150" FontFamily="Cascadia Code, Consolas" FontSize="19" Margin="0,9,0,14" />
                                    <Button Content="复制 SOCKS5 地址" HorizontalAlignment="Left" Padding="12,8" Click="CopySocks_Click" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="HTTP / HTTPS" Foreground="{StaticResource SecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HttpEndpoint" Text="127.0.0.1:8118" FontFamily="Cascadia Code, Consolas" FontSize="19" Margin="0,9,0,14" />
                                    <Button x:Name="SystemProxyButton" Content="设置 Windows 代理" HorizontalAlignment="Left" Padding="12,8" IsEnabled="False" Click="SystemProxy_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Tor 网络" Style="{StaticResource LabelText}"/><TextBlock x:Name="NetworkState" Text="未连接" FontSize="14"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="桥接模式" Style="{StaticResource LabelText}"/><TextBlock x:Name="BridgeState" Text="直连" FontSize="14"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Windows 代理" Style="{StaticResource LabelText}"/><TextBlock x:Name="ProxyState" Text="未启用" FontSize="14"/></StackPanel>
                        </Grid>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="TUN 虚拟网卡模式" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TunStatusText" Text="未启用" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,0" />
                                    <TextBlock Text="可选接管设备 TCP 流量并经 Tor 转发。需要管理员权限；UDP 不支持。正常停止时由 sing-box 清理路由；异常退出后的路由恢复尚未验证。此功能尚未在真实网卡环境验证。" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                                <Button x:Name="TunButton" Grid.Column="2" Content="启动 TUN" VerticalAlignment="Center" IsEnabled="False" Click="Tun_Click" />
                            </Grid>
                        </Border>
                        <Border Background="#111820" BorderBrush="#26313C" BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" FontSize="12">
                                Windows 版通过 SOCKS5 / HTTP 代理工作。系统代理只影响遵循 Windows 用户代理设置的应用；它不会自动代理所有应用或系统服务。
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="BridgesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="连接方式" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="如果网络无法直连 Tor，可尝试 Snowflake、obfs4 或粘贴可信来源提供的桥接行。桥接可用性随网络环境变化。" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,18" />
                                <TextBlock Text="桥接传输" Style="{StaticResource LabelText}" />
                                <ComboBox x:Name="BridgeModeCombo" Width="290" HorizontalAlignment="Left" SelectionChanged="BridgeMode_SelectionChanged">
                                    <ComboBoxItem Content="直连 Tor" Tag="none" />
                                    <ComboBoxItem Content="obfs4 内置桥接" Tag="obfs4" />
                                    <ComboBoxItem Content="meek 内置桥接" Tag="meek" />
                                    <ComboBoxItem Content="Snowflake 内置桥接" Tag="snowflake" />
                                    <ComboBoxItem Content="Snowflake AMP 内置桥接" Tag="snowflake-amp" />
                                    <ComboBoxItem Content="WebTunnel（自定义桥接）" Tag="webtunnel" />
                                    <ComboBoxItem Content="DNSTT 内置桥接" Tag="dnstt" />
                                    <ComboBoxItem Content="自定义桥接行" Tag="custom" />
                                </ComboBox>
                                <TextBlock Text="桥接行（每行一个，可留空使用随运行时附带的内置入口）" Style="{StaticResource LabelText}" Margin="0,18,0,7" />
                                <TextBox x:Name="BridgeLinesBox" Height="126" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Moat 国家代码（可选）" Style="{StaticResource LabelText}"/><TextBox x:Name="MoatCountryBox" MaxLength="2" /></StackPanel>
                                    <Button Grid.Column="2" Content="通过 Moat 获取" VerticalAlignment="Bottom" Click="FetchMoatBridges_Click" />
                                </Grid>
                                <TextBlock x:Name="MoatStatusText" Text="Moat 请求通过随包 meek_lite 临时隧道发送。" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <Button Content="保存网络设置" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SaveSettings_Click" />
                            </StackPanel>
                        </Border>
                        <Border Background="#121A21" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" FontSize="12">桥接地址和出口节点会暴露在本机配置文件中。不要在共享电脑上输入你不希望其他本机用户看到的信息。Tor 的桥接并不能保证绕过所有网络限制。</TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ServicesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="发布本地服务为 .onion 地址" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="将本机服务端口映射到 Tor v3 洋葱服务。目标服务仍由你自己的本地服务器提供。" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,18" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="服务名称" Style="{StaticResource LabelText}"/><TextBox x:Name="ServiceNameBox" Text="local-service" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="洋葱端口" Style="{StaticResource LabelText}"/><TextBox x:Name="ServiceVirtualPortBox" Text="80" /></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="本机端口" Style="{StaticResource LabelText}"/><TextBox x:Name="ServiceTargetPortBox" Text="8080" /></StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="添加并应用（重启 Tor）" Click="AddService_Click" />
                                    <Button Content="导出服务配置" Margin="10,0,0,0" Click="ExportOnionServices_Click" />
                                    <Button Content="导入服务配置" Margin="10,0,0,0" Click="ImportOnionServices_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="已配置的服务" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,12" />
                        <ItemsControl x:Name="ServicesList" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ClientAuthPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="访问受保护的 v3 Onion 服务" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="为需要客户端授权的 .onion 服务保存私钥。密钥写入 Tor 的 ClientOnionAuthDir，并限制为当前 Windows 用户访问。" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,18" />
                                <TextBlock Text="v3 Onion 地址" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="ClientAuthDomainBox" Margin="0,0,0,12" />
                                <TextBlock Text="X25519 客户端私钥（52 位 base32）" Style="{StaticResource LabelText}" />
                                <PasswordBox x:Name="ClientAuthKeyBox" Foreground="{StaticResource PrimaryBrush}" Background="#0D1319" BorderBrush="{StaticResource LineBrush}" Padding="12,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="添加授权" Click="AddClientAuth_Click" />
                                    <Button Content="导入 .auth_private" Margin="10,0,0,0" Click="ImportClientAuth_Click" />
                                    <Button Content="导出所选" Margin="10,0,0,0" Click="ExportClientAuth_Click" />
                                    <Button Content="删除所选" Margin="10,0,0,0" Click="RemoveClientAuth_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="已保存的 Onion 授权" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <ListBox x:Name="ClientAuthList" MinHeight="120" MaxHeight="300" DisplayMemberPath="." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="12" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="清空显示" Click="ClearLogs_Click" />
                        <Button Content="打开日志目录" Margin="8,0,0,0" Click="OpenLogFolder_Click" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                            <StackPanel>
                                <TextBlock Text="本机代理端口" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="更改后需要重启 Tor 才会应用。端口只绑定到 127.0.0.1。" Foreground="{StaticResource SecondaryBrush}" Margin="0,7,0,18" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="SOCKS5" Style="{StaticResource LabelText}"/><TextBox x:Name="SocksPortBox" Text="9150" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="HTTP / HTTPS" Style="{StaticResource LabelText}"/><TextBox x:Name="HttpPortBox" Text="8118" /></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="Tor 控制端口" Style="{StaticResource LabelText}"/><TextBox x:Name="ControlPortBox" Text="9151" /></StackPanel>
                                </Grid>
                                <TextBlock Text="出口国家代码（可选，例如 us、de；不保证可用性）" Style="{StaticResource LabelText}" Margin="0,18,0,7" />
                                <TextBox x:Name="ExitCountryBox" Width="250" HorizontalAlignment="Left" MaxLength="2" />
                                <CheckBox x:Name="WindowsProxyCheckBox" Content="Tor 连接成功后自动启用 Windows 当前用户 HTTP/HTTPS 代理" Margin="0,20,0,4" />
                                <TextBlock Text="退出或 Tor 异常停止时，Orbot PC 会恢复此前保存的当前用户代理值。" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="24,0,0,0" />
                                <CheckBox x:Name="StartOnLoginCheckBox" Content="登录 Windows 后自动启动 Orbot PC" Margin="0,12,0,4" />
                                <TextBlock Text="仅为当前 Windows 用户设置；关闭时恢复原有启动项。" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="24,0,0,0" />
                                <Button Content="保存设置" HorizontalAlignment="Left" Margin="0,20,0,0" Click="SaveSettings_Click" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Snowflake 志愿中继" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="开启后，本机将通过 WebRTC 中继其他 Tor 用户到 Tor 网桥的流量。每次最多服务 1 个客户端，会使用网络流量；只在你愿意提供中继时手动开启。" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,12" />
                                <TextBlock x:Name="SnowflakeVolunteerStateText" Text="已停止" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="StartSnowflakeVolunteerButton" Content="启动志愿中继" Click="StartSnowflakeVolunteer_Click" />
                                    <Button x:Name="StopSnowflakeVolunteerButton" Content="停止志愿中继" Margin="10,0,0,0" IsEnabled="False" Click="StopSnowflakeVolunteer_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Tor 高级网络选项" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="这些选项直接写入 Tor 配置；空端口表示不启用。修改后会在保存时重启 Tor。" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,18" />
                                <TextBlock Text="可选本机监听" Style="{StaticResource LabelText}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="DNS 端口（可选）" Style="{StaticResource LabelText}"/><TextBox x:Name="DnsPortBox" Text="0" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="HTTP 隧道端口（可选）" Style="{StaticResource LabelText}"/><TextBox x:Name="HttpTunnelPortBox" Text="0" /></StackPanel>
                                </Grid>
                                <CheckBox x:Name="AutomapHostsCheckBox" Content="为 DNS 解析启用 AutomapHostsOnResolve" Margin="0,10,0,0" />
                                <TextBlock Text="虚拟地址网络（VirtualAddrNetworkIPv4）" Style="{StaticResource LabelText}" Margin="0,12,0,7" />
                                <TextBox x:Name="VirtualAddrNetworkBox" Text="10.192.0.0/10" Width="210" HorizontalAlignment="Left" />

                                <TextBlock Text="路由与节点偏好" Style="{StaticResource LabelText}" Margin="0,18,0,7" />
                                <TextBlock Text="入口节点（EntryNodes）" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="EntryNodesBox" Margin="0,0,0,9" />
                                <TextBlock Text="排除节点（ExcludeNodes）" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="ExcludeNodesBox" Margin="0,0,0,9" />
                                <TextBlock Text="排除出口节点（ExcludeExitNodes）" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="ExcludeExitNodesBox" Margin="0,0,0,9" />
                                <TextBlock Text="可达地址（ReachableAddresses）" Style="{StaticResource LabelText}" />
                                <TextBox x:Name="ReachableAddressesBox" />
                                <TextBlock Text="按顺序：入口节点、排除节点、排除出口节点、可达地址；留空表示 Tor 默认。" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <CheckBox x:Name="StrictNodesCheckBox" Content="严格遵守节点选择（StrictNodes）" Margin="0,10,0,0" />

                                <TextBlock Text="Tor 协议偏好（未设置 = Tor 默认）" Style="{StaticResource LabelText}" Margin="0,18,0,7" />
                                <WrapPanel>
                                    <CheckBox x:Name="ConnectionPaddingCheckBox" IsThreeState="True" Content="连接填充" Margin="0,0,18,8" />
                                    <CheckBox x:Name="CircuitPaddingCheckBox" IsThreeState="True" Content="电路填充" Margin="0,0,18,8" />
                                    <CheckBox x:Name="ReducedConnectionPaddingCheckBox" IsThreeState="True" Content="降低连接填充" Margin="0,0,18,8" />
                                    <CheckBox x:Name="ReducedCircuitPaddingCheckBox" IsThreeState="True" Content="降低电路填充" Margin="0,0,18,8" />
                                    <CheckBox x:Name="ClientUseIPv4CheckBox" IsThreeState="True" Content="允许 IPv4" Margin="0,0,18,8" />
                                    <CheckBox x:Name="ClientUseIPv6CheckBox" IsThreeState="True" Content="允许 IPv6" Margin="0,0,18,8" />
                                    <CheckBox x:Name="PreferIPv6CheckBox" IsThreeState="True" Content="优先 IPv6" Margin="0,0,18,8" />
                                    <CheckBox x:Name="IPv6TrafficCheckBox" IsThreeState="True" Content="启用 IPv6 流量" Margin="0,0,18,8" />
                                    <CheckBox x:Name="NoIPv4TrafficCheckBox" IsThreeState="True" Content="禁止 IPv4 流量" Margin="0,0,18,8" />
                                </WrapPanel>
                                <TextBlock Text="SOCKS 隔离（仅对本机 SOCKS5 监听生效）" Style="{StaticResource LabelText}" Margin="0,10,0,7" />
                                <WrapPanel>
                                    <CheckBox x:Name="IsolateDestAddrCheckBox" Content="按目标地址隔离" Margin="0,0,18,8" />
                                    <CheckBox x:Name="IsolateDestPortCheckBox" Content="按目标端口隔离" Margin="0,0,18,8" />
                                    <CheckBox x:Name="IsolateClientProtocolCheckBox" Content="按客户端协议隔离" Margin="0,0,18,8" />
                                    <CheckBox x:Name="KeepAliveIsolateSocksAuthCheckBox" Content="保持 SOCKS 授权隔离" Margin="0,0,18,8" />
                                </WrapPanel>

                                <TextBlock Text="Tor 出站代理（可选）" Style="{StaticResource LabelText}" Margin="0,10,0,7" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="代理类型" Style="{StaticResource LabelText}"/><ComboBox x:Name="OutboundProxyTypeCombo" SelectedIndex="0">
                                        <ComboBoxItem Tag="none">无</ComboBoxItem>
                                        <ComboBoxItem Tag="https">HTTPS</ComboBoxItem>
                                        <ComboBoxItem Tag="socks4">SOCKS4</ComboBoxItem>
                                        <ComboBoxItem Tag="socks5">SOCKS5</ComboBoxItem>
                                    </ComboBox></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="代理主机或 IP" Style="{StaticResource LabelText}"/><TextBox x:Name="OutboundProxyHostBox" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="端口" Style="{StaticResource LabelText}"/><TextBox x:Name="OutboundProxyPortBox" /></StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="代理用户名（可选）" Style="{StaticResource LabelText}" /><TextBox x:Name="OutboundProxyUsernameBox" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="代理密码（可选）" Style="{StaticResource LabelText}" /><PasswordBox x:Name="OutboundProxyPasswordBox" Foreground="{StaticResource PrimaryBrush}" Background="#0D1319" BorderBrush="{StaticResource LineBrush}" Padding="12,10" /></StackPanel>
                                </Grid>
                                <TextBlock Text="代理类型、主机和端口需同时填写；密码仅在本地设置文件中保存。未填写时会尝试检测 Windows 当前代理中的本机 SOCKS5 上游。" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

                                <TextBlock Text="Smart Connect 回退顺序" Style="{StaticResource LabelText}" Margin="0,18,0,7" />
                                <CheckBox x:Name="EnableSmartConnectCheckBox" Content="连接失败时启用回退规划器" />
                                <TextBox x:Name="SmartConnectModesBox" Text="none,snowflake,snowflake-amp,obfs4" Margin="0,7,0,0" />
                                <TextBlock Text="可用值：none、snowflake、snowflake-amp、obfs4、meek、webtunnel、custom。顺序用逗号分隔。" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="回退等待时间（秒）" Style="{StaticResource LabelText}" Margin="0,12,0,7" />
                                <TextBox x:Name="SmartConnectFallbackSecondsBox" Text="90" Width="140" HorizontalAlignment="Left" />
                                <Border Background="#171D23" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,18,0,0">
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" FontSize="12">Windows 版本使用本机 SOCKS5 / HTTP 代理；应用需支持 SOCKS5 或遵循 Windows 用户代理设置。</TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Background="#121A21" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" FontSize="12">Windows 版本提供本机代理和可选 TUN 模式；TUN 默认关闭，修改系统路由并阻断 UDP，尚未经过真实网卡验证。</TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
